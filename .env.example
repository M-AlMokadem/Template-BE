ASPNETCORE_ENVIRONMENT=Development
POSTGRES_DB=VersionZero
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432
POSTGRES_CONTAINER_NAME=versionzero-postgres
POSTGRES_VOLUME_NAME=versionzero-postgres-data
ConnectionStrings__VersionZero=Host=localhost;Port=5432;Database=VersionZero;Username=postgres;Password=postgres
Jwt__Key=replace-with-a-random-secret-at-least-32-characters
Jwt__Issuer=VersionZero.API
Jwt__Audience=VersionZero.Client
Jwt__ExpiresInMinutes=480
Jwt__RefreshTokenExpiresInDays=14
SeedAdmin__Email=admin@example.com
SeedAdmin__Password=ChangeMe123!
Frontend__ApiBaseUrl=http://localhost:5186/api/
Frontend__AllowedOrigins=http://localhost:4200;https://localhost:4200;http://127.0.0.1:4200
